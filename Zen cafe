<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Creative Hub | Coming Soon</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-900 font-sans">

    <!-- Hero Section -->
    <header class="min-h-screen flex flex-col items-center justify-center text-center px-6 bg-white border-b border-slate-200">
        <h1 class="text-5xl md:text-7xl font-extrabold text-indigo-600 mb-4">Cafe + Classes + Games + Art</h1>
        <p class="text-xl md:text-2xl text-slate-600 max-w-3xl mb-8">A vibrant space to elevate flavors, master the kitchen, challenge friends at board games, and unleash your inner artist.</p>
        
        <form class="w-full max-w-md flex flex-col sm:flex-row gap-3">
            <input type="email" placeholder="Enter your email" class="flex-1 px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 outline-none" required>
            <button type="submit" class="bg-indigo-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-indigo-700 transition">Get Early Access</button>
        </form>
    </header>

    <!-- Our Story Section -->
    <section class="py-20 px-6 max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-6 text-center">Our Story</h2>
        <div class="bg-indigo-50 p-8 rounded-2xl text-lg text-slate-700 border-l-4 border-indigo-600">
            "I am a student founder in Year 9 based in Dubai. My vision is to create a community destination that blends my love for vegetarian cooking with the joy of shared activities. Whether you are here for a risotto workshop, a competitive board game night, or a painting session, we are here to help you learn and grow."
        </div>
    </section>

    <!-- How It Works Section -->
    <section class="py-20 bg-white px-6">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-3xl font-bold mb-12 text-center">Four Ways to Connect</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
                <div class="p-6 rounded-xl border border-slate-100 shadow-sm">
                    <h3 class="font-bold text-xl mb-2">The Cafe</h3>
                    <p class="text-slate-600 text-sm">Savor premium vegetarian dishes in a relaxed environment.</p>
                </div>
                <div class="p-6 rounded-xl border border-slate-100 shadow-sm">
                    <h3 class="font-bold text-xl mb-2">Cooking Classes</h3>
                    <p class="text-slate-600 text-sm">Professional instruction to help you elevate flavors at home.</p>
                </div>
                <div class="p-6 rounded-xl border border-slate-100 shadow-sm">
                    <h3 class="font-bold text-xl mb-2">Board Games</h3>
                    <p class="text-slate-600 text-sm">A curated library of games for strategy and fun with friends.</p>
                </div>
                <div class="p-6 rounded-xl border border-slate-100 shadow-sm">
                    <h3 class="font-bold text-xl mb-2">Painting</h3>
                    <p class="text-slate-600 text-sm">Guided art activities to spark your creativity while you sip coffee.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Us Section -->
    <footer class="py-20 px-6 text-center">
        <h2 class="text-3xl font-bold mb-6">Contact Us</h2>
        <a href="mailto:hello@startup.com" class="bg-slate-900 text-white px-10 py-4 rounded-full font-bold hover:scale-105 transition-transform inline-block">Contact Us</a>
        <p class="mt-12 text-xs text-slate-400">© 2026 Creative Hub Startup.</p>
    </footer>

</body>
</html>
